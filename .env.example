# Environment Variables - Copy to .env and update with your values

# Application
NODE_ENV=development
PORT=5000
APP_NAME=RealEstateSaaS
APP_URL=http://localhost:5000

# Database
MONGODB_URI=mongodb://localhost:27017/real-estate-saas
MONGODB_TEST_URI=mongodb://localhost:27017/real-estate-saas-test

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=43wxB6i+w0XIQxPG9pC0DRvpNL8clJvPS9R6LvHot+MWDUUTZil58Lpvenozb2sz
JWT_REFRESH_SECRET=csTybcOv63L/63DxSMXFmrrXdWZhwnO2fApTD2xIEXhWKr1noA+OcFlQZOcumCf+
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@realestate-saas.com

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your-s3-bucket-name
AWS_S3_REGION=us-east-1

# Session
SESSION_SECRET=your_session_secret_key

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Admin
ADMIN_EMAIL=admin@realestate-saas.com

# Feature Flags
ENABLE_REAL_TIME_UPDATES=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_FILE_UPLOADS=true
